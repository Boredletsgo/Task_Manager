@model Task_Manager.Models.TaskItem

@{
    ViewData["Title"] = "Edit Task";
    Layout = "~/Views/Shared/_TaskLayout.cshtml";
}

<div class="edit-task-form-container">
    <h2>Edit Task</h2>

    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="form-group">
            <label>Title</label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
        <div class="form-group form-check">
            <label>Is Completed</label>
            <input asp-for="IsCompleted" type="checkbox" />
        </div>
        <button type="submit" class="btn btn-primary mt-2">Save Changes</button>
    </form>
</div>

<style>
    .edit-task-form-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 30px;
        background-color: #ffffff;
        border-radius: 12px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
    }

        .edit-task-form-container h2 {
            text-align: center;
            margin-bottom: 25px;
            font-weight: 600;
            color: #333;
        }

        .edit-task-form-container .form-group {
            margin-bottom: 20px;
        }

        .edit-task-form-container label {
            font-weight: 500;
            color: #555;
            display: block;
            margin-bottom: 8px;
        }

        .edit-task-form-container input.form-control,
        .edit-task-form-container textarea.form-control {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
            transition: border-color 0.3s ease;
        }

            .edit-task-form-container input.form-control:focus,
            .edit-task-form-container textarea.form-control:focus {
                border-color: #007bff;
                outline: none;
            }

        .edit-task-form-container input[type="checkbox"] {
            transform: scale(1.2);
            margin-left: 5px;
        }

        .edit-task-form-container button.btn-primary {
            width: 100%;
            padding: 10px;
            font-size: 16px;
            border-radius: 6px;
        }
</style>
